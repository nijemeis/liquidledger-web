# ── Database ────────────────────────────────────────────────────────────────
# The app role must NOT be a superuser and must not have BYPASSRLS
# (row-level security keeps tenants apart).
DATABASE_URL="postgresql://liquidledger:liquidledger@localhost:5432/liquidledger"
# Direct (unpooled) connection for migrations. Behind PgBouncer, add ?pgbouncer=true to DATABASE_URL.
DIRECT_URL="postgresql://liquidledger:liquidledger@localhost:5432/liquidledger"

# ── URLs ────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3000/admin"
# Production only: serve the platform admin console on its own host.
# ADMIN_HOST="admin.liquidledger.net"

# ── Security ────────────────────────────────────────────────────────────────
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts TOTP secrets at rest.
APP_ENCRYPTION_KEY=""
# Passkeys: the registrable domain (covers app + admin subdomains) and allowed origins.
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="Liquid Ledger"
# WEBAUTHN_ORIGINS="https://liquidledger.net,https://admin.liquidledger.net"
# Header with the real client IP behind your load balancer (DigitalOcean: do-connecting-ip).
TRUSTED_IP_HEADER="x-forwarded-for"

# ── Email (password resets, invites, security alerts) ──────────────────────
# Without SMTP_URL, development prints mails to the server log.
# SMTP_URL="smtps://user:password@smtp.example.com:465"
# MAIL_FROM="Liquid Ledger <no-reply@liquidledger.net>"

# ── Optional integrations ───────────────────────────────────────────────────
# Reading uploaded invoices and receipts with Claude.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL=""
# Store documents in S3-compatible storage (DigitalOcean Spaces) instead of the database.
# S3_BUCKET="" S3_ENDPOINT="https://fra1.digitaloceanspaces.com" S3_REGION="fra1" S3_ACCESS_KEY_ID="" S3_SECRET_ACCESS_KEY=""
# SMS as a fallback second factor (Twilio).
# TWILIO_ACCOUNT_SID="" TWILIO_AUTH_TOKEN="" TWILIO_FROM="+31…"
